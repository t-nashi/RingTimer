{
  "name": "ringtimer-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop ring-style timer, alarm, and stopwatch app.",
  "author": "Local",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && electron-packager . \"RingTimer\" --icon=assets/icon --out=release --overwrite --prune=true --ignore=\"^/release($|/)\" --ignore=\"^/node_modules/.cache($|/)\"",
    "pack:win": "npm run build && electron-packager . \"RingTimer\" --platform=win32 --arch=x64 --icon=assets/icon.ico --out=release --overwrite --prune=true --ignore=\"^/release($|/)\" --ignore=\"^/node_modules/.cache($|/)\"",
    "pack:mac": "npm run build && electron-packager . \"RingTimer\" --platform=darwin --arch=arm64,x64 --icon=assets/icon.icns --out=release --overwrite --prune=true --ignore=\"^/release($|/)\" --ignore=\"^/node_modules/.cache($|/)\"",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.16"
  }
}
